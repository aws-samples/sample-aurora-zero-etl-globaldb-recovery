{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DescribeConfiguredGlobalCluster",
      "Effect": "Allow",
      "Action": "rds:DescribeGlobalClusters",
      "Resource": "arn:aws:rds::111122223333:global-cluster:aurora-postgres-global"
    },
    {
      "Sid": "DescribeConfiguredMemberClusters",
      "Effect": "Allow",
      "Action": "rds:DescribeDBClusters",
      "Resource": [
        "arn:aws:rds:us-east-1:111122223333:cluster:aurora-postgres-primary",
        "arn:aws:rds:us-west-2:111122223333:cluster:aurora-postgres-secondary"
      ]
    },
    {
      "Sid": "DescribeAccountIntegrations",
      "Effect": "Allow",
      "Action": "rds:DescribeIntegrations",
      "Resource": "arn:aws:rds:*:111122223333:integration:*"
    },
    {
      "Sid": "CreateIntegrationForConfiguredSources",
      "Effect": "Allow",
      "Action": "rds:CreateIntegration",
      "Resource": [
        "arn:aws:rds:us-east-1:111122223333:cluster:aurora-postgres-primary",
        "arn:aws:rds:us-west-2:111122223333:cluster:aurora-postgres-secondary"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "zero-etl-globaldb-recovery",
          "aws:RequestTag/GlobalCluster": "aurora-postgres-global"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["ManagedBy", "GlobalCluster"]
        }
      }
    },
    {
      "Sid": "CreateOwnedIntegrationResource",
      "Effect": "Allow",
      "Action": "rds:CreateIntegration",
      "Resource": "arn:aws:rds:*:111122223333:integration:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "zero-etl-globaldb-recovery",
          "aws:RequestTag/GlobalCluster": "aurora-postgres-global"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["ManagedBy", "GlobalCluster"]
        }
      }
    },
    {
      "Sid": "DeleteOwnedIntegrations",
      "Effect": "Allow",
      "Action": "rds:DeleteIntegration",
      "Resource": "arn:aws:rds:*:111122223333:integration:*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/ManagedBy": "zero-etl-globaldb-recovery",
          "aws:ResourceTag/GlobalCluster": "aurora-postgres-global"
        }
      }
    },
    {
      "Sid": "TagIntegrationOnCreate",
      "Effect": "Allow",
      "Action": "rds:AddTagsToResource",
      "Resource": "arn:aws:rds:*:111122223333:integration:*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/ManagedBy": "zero-etl-globaldb-recovery",
          "aws:RequestTag/GlobalCluster": "aurora-postgres-global"
        },
        "ForAllValues:StringEquals": {
          "aws:TagKeys": ["ManagedBy", "GlobalCluster"]
        }
      }
    },
    {
      "Sid": "AuthorizeLocalRedshiftInboundIntegration",
      "Effect": "Allow",
      "Action": [
        "redshift:CreateInboundIntegration",
        "redshift:DeleteInboundIntegration",
        "redshift-serverless:CreateInboundIntegration"
      ],
      "Resource": "arn:aws:redshift-serverless:us-east-1:111122223333:namespace/REPLACE-WITH-NAMESPACE-UUID"
    },
    {
      "Sid": "UseLocalIntegrationKmsKey",
      "Effect": "Allow",
      "Action": ["kms:CreateGrant", "kms:DescribeKey"],
      "Resource": "arn:aws:kms:us-east-1:111122223333:key/REPLACE-WITH-KEY-ID"
    },
    {
      "Sid": "PublishNotifications",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:111122223333:globaldb-analytics-zero-etl-recovery"
    },
    {
      "Sid": "UpdateReplicationAlarms",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricAlarm",
      "Resource": [
        "arn:aws:cloudwatch:us-east-1:111122223333:alarm:globaldb-analytics-zero-etl-integration-lag",
        "arn:aws:cloudwatch:us-east-1:111122223333:alarm:globaldb-analytics-zero-etl-tables-failed"
      ]
    },
    {
      "Sid": "SendToDeadLetterQueue",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:us-east-1:111122223333:globaldb-analytics-zero-etl-recovery-dlq"
    },
    {
      "Sid": "UseNotificationKeyViaMessaging",
      "Effect": "Allow",
      "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "arn:aws:kms:us-east-1:111122223333:key/REPLACE-WITH-NOTIFICATION-KEY-ID",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "sns.us-east-1.amazonaws.com",
            "sqs.us-east-1.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "DecryptEnvironmentVariables",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:us-east-1:111122223333:key/REPLACE-WITH-NOTIFICATION-KEY-ID"
    },
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-1:111122223333:log-group:/aws/lambda/globaldb-analytics-zero-etl-recovery:*"
    },
    {
      "Sid": "TraceWithXRay",
      "Effect": "Allow",
      "Action": ["xray:PutTraceSegments", "xray:PutTelemetryRecords"],
      "Resource": "*"
    }
  ]
}
